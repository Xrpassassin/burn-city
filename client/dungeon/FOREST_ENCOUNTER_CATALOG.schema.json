{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burn-city.invalid/schemas/forest-encounter-catalog.schema.json",
  "title": "BURN City Forest Encounter Catalog",
  "description": "Design-time schema for data-driven regional encounters; not production runtime integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "safetyPolicy",
    "archetypes",
    "regions",
    "encounterTemplates",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "design-only"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safetyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedZoneIds",
        "denyHostileSpawnsInProtectedZones",
        "denyHostileAggroAcrossProtectedBoundary",
        "maxSimultaneousHostileEntitiesPerPlayer",
        "maxActiveEncounterGroupsPerRegion",
        "minimumGroupSeparationMeters",
        "eliteRequiresExplicitRegionPermission"
      ],
      "properties": {
        "protectedZoneIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denyHostileSpawnsInProtectedZones": {
          "type": "boolean",
          "const": true
        },
        "denyHostileAggroAcrossProtectedBoundary": {
          "type": "boolean",
          "const": true
        },
        "maxSimultaneousHostileEntitiesPerPlayer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxActiveEncounterGroupsPerRegion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "minimumGroupSeparationMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eliteRequiresExplicitRegionPermission": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "behaviorProfile",
          "telegraphRequired",
          "counterplay"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "role": {
            "type": "string"
          },
          "behaviorProfile": {
            "type": "string"
          },
          "telegraphRequired": {
            "type": "boolean",
            "const": true
          },
          "counterplay": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "band",
          "allowedEncounterTemplateIds",
          "eliteAllowed",
          "maxThreatTier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "band": {
            "type": "string",
            "enum": [
              "protected",
              "outer",
              "middle",
              "deep"
            ]
          },
          "allowedEncounterTemplateIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "eliteAllowed": {
            "type": "boolean"
          },
          "maxThreatTier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "encounterTemplates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "threatTier",
          "elite",
          "members",
          "intent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "threatTier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "elite": {
            "type": "boolean"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "archetypeId",
                "count"
              ],
              "properties": {
                "archetypeId": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              }
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eligibleRegionIds",
          "allowedTemplateIds",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "eligibleRegionIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowedTemplateIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
