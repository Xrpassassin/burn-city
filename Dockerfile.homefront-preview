FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server ./server
COPY client ./client
COPY scripts/homefront-preview-gateway.cjs ./scripts/homefront-preview-gateway.cjs
ENV PORT=8080
ENV HOMEFRONT_PREVIEW_MODE=1
ENV HOMEFRONT_CONTINUOUS_MOVEMENT=0
ENV DRY_RUN=true
ENV BURN_JOB_IN_SERVER=false
ENV DATA_DIR=/tmp/homefront-preview
EXPOSE 8080
# Combined immersive + guest preview: never runs the production payments server or mounts a volume.
CMD ["node","scripts/homefront-preview-gateway.cjs"]
